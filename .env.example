# Copy this file to .env and fill in your real values.
# .env itself is gitignored and never committed - keep secrets out of git.

# Database connection - update user/password/dbname for your local setup
DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/baroudeurs?serverVersion=5.7"

# Cloudinary - get these from https://cloudinary.com/console > API Keys
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@dy13axswo

# Symfony
APP_ENV=dev
APP_SECRET=change_this_to_a_random_string

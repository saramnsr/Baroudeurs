<!--====== Start Hero ======-->
<section class="services-hero" id="servicesHero">
    <div class="services-hero-slides">
        <div class="services-hero-slide active" style="background-image: url('{{ asset('assets/images/service/new-service/hero1.jpg') }}');"></div>
        <div class="services-hero-slide" style="background-image: url('{{ asset('assets/images/service/new-service/hero2.jpg') }}');"></div>
    </div>
    <div class="services-hero-overlay"></div>

    <div class="container" style="position: relative; z-index: 3;">
        <div class="services-hero-content text-start">
            <span class="services-hero-label">
                <span class="label-line"></span>
                {{ 'nav.services'|trans|upper }}
            </span>
            <h1 class="services-hero-title">
                {{ 'services_page.hero_title_line1'|trans }}<br>
                {{ 'services_page.hero_title_line2'|trans }}
            </h1>
            <p class="services-hero-text">{{ 'services_page.hero_subtitle'|trans }}</p>
            <a href="#services" class="services-hero-btn">
                {{ 'services_page.hero_cta'|trans }}
                <i class="fas fa-arrow-down"></i>
            </a>
        </div>

        <div class="services-hero-locations">
            <a href="#playground" class="services-hero-location">Douz</a>
            <a href="#playground" class="services-hero-location">Sahara</a>
            <a href="#playground" class="services-hero-location">Djerba</a>
            <a href="#playground" class="services-hero-location">Tozeur</a>
            <a href="#playground" class="services-hero-location">Ksar Ghilane</a>
            <a href="#playground" class="services-hero-location">Tataouine</a>
        </div>
    </div>

    <!-- Wavy bottom -->
    <div class="services-hero-wave">
        <svg viewBox="0 0 1440 140" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,70 C240,120 480,20 720,60 C960,100 1200,130 1440,70 L1440,140 L0,140 Z" fill="#F6F2E9"></path>
        </svg>
    </div>
</section>

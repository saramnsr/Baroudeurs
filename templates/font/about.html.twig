{% extends 'base.html.twig' %}

{% block title %}{{ 'about_page.title'|trans }}{% endblock %}

{% block body %}

<!--====== Start Hero / Banner ======-->
<section class="about-hero" style="background-image: url('{{ asset('assets/images/service/oasis.jpeg') }}');">
    <div class="about-hero-overlay"></div>
    <div class="container">
        <div class="about-hero-content text-center">
            <span class="about-hero-label">
                <span class="label-line"></span>
                {{ 'about_page.hero_label'|trans }}
                <span class="label-line"></span>
            </span>
            <h1 class="about-hero-title">{{ 'about_page.hero_title'|trans }}</h1>
            <p class="about-hero-subtitle">{{ 'about_page.hero_subtitle'|trans }}</p>
            <p class="about-hero-text">{{ 'about_page.hero_text'|trans }}</p>
            <a href="{{ path('app_font_circuits') }}" class="about-hero-btn">
                {{ 'about_page.hero_button'|trans }}
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>

<!-- Wavy bottom — medium -->
<div class="about-hero-wave">
    <svg viewBox="0 0 1440 140" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0,70 C240,120 480,20 720,60 C960,100 1200,130 1440,70 L1440,140 L0,140 Z" fill="#FAF3ED"></path>
    </svg>
</div>
</section>
<!--====== End Hero / Banner ======-->

<!--====== Start Our Story ======-->
<section class="about-story pt-100 pb-80">
    <div class="container">
        <div class="row align-items-center">

            <!-- Left: Image with decorative lines -->
            <div class="col-lg-6 mb-30">
                <div class="about-story-image-wrap">
                    <!-- Top-left decorative arcs -->
                    <span class="deco-line deco-line-green tl"></span>
                    <span class="deco-line deco-line-orange tl"></span>

                    <div class="about-story-image">
                        <img src="{{ asset('assets/images/Circuits/excursion Tatouine.jpg') }}"
                             alt="{{ 'about_page.story_title'|trans }}"
                             loading="lazy" decoding="async">
                    </div>

                    <!-- Bottom-right decorative arcs -->
                    <span class="deco-line deco-line-green br"></span>
                    <span class="deco-line deco-line-orange br"></span>
                </div>
            </div>

            <!-- Right: Text -->
            <div class="col-lg-6 mb-30">
                <div class="about-story-content">
                    <span class="about-story-label">
                        <span class="label-line"></span>
                        {{ 'about_page.story_label'|trans }}
                    </span>

                    <h2 class="about-story-title">{{ 'about_page.story_title'|trans }}</h2>

                    <p>{{ 'about_page.story_p1'|trans }}</p>
                    <p>{{ 'about_page.story_p2'|trans }}</p>
                    <p>{{ 'about_page.story_p3'|trans }}</p>

                    <div class="about-story-objective">
                        <p class="objective-label">{{ 'about_page.story_objective'|trans }}</p>
                        <p class="objective-text">{{ 'about_page.story_tagline'|trans }}</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
<!--====== End Our Story ======-->

<!--====== Start Our Values ======-->
<section class="about-values pt-80 pb-80">
    <div class="container">
        <div class="row justify-content-center mb-50">
            <div class="col-lg-8 text-center">
                <span class="about-section-subtitle">{{ 'about_page.values_subtitle'|trans }}</span>
                <h2 class="about-section-title">{{ 'about_page.values_title'|trans }}</h2>
            </div>
        </div>

        <div class="row">
            <!-- Card 1 — Authenticity (beige / orange) -->
            <div class="col-lg-3 col-md-6 mb-30">
                <div class="about-value-card card-beige">
                    <div class="about-value-icon icon-orange">
                        <i class="flaticon-cottage"></i>
                    </div>
                    <h4 class="about-value-title">{{ 'about_page.values.authenticity.title'|trans }}</h4>
                    <p class="about-value-text">{{ 'about_page.values.authenticity.text'|trans }}</p>
                </div>
            </div>

            <!-- Card 2 — Adventure (light green / green) -->
            <div class="col-lg-3 col-md-6 mb-30">
                <div class="about-value-card card-green">
                    <div class="about-value-icon icon-green">
                        <i class="flaticon-camping"></i>
                    </div>
                    <h4 class="about-value-title">{{ 'about_page.values.adventure.title'|trans }}</h4>
                    <p class="about-value-text">{{ 'about_page.values.adventure.text'|trans }}</p>
                </div>
            </div>

            <!-- Card 3 — Proximity (light peach / orange-red) -->
            <div class="col-lg-3 col-md-6 mb-30">
                <div class="about-value-card card-peach">
                    <div class="about-value-icon icon-orange-red">
                <i class="flaticon-hiking"></i>
                    </div>
                    <h4 class="about-value-title">{{ 'about_page.values.proximity.title'|trans }}</h4>
                    <p class="about-value-text">{{ 'about_page.values.proximity.text'|trans }}</p>
                </div>
            </div>

            <!-- Card 4 — Safety (light blue / blue) -->
            <div class="col-lg-3 col-md-6 mb-30">
                <div class="about-value-card card-blue">
                    <div class="about-value-icon icon-blue">
                        <i class="flaticon-bonfire"></i>
                    </div>
                    <h4 class="about-value-title">{{ 'about_page.values.safety.title'|trans }}</h4>
                    <p class="about-value-text">{{ 'about_page.values.safety.text'|trans }}</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!--====== End Our Values ======-->
<!--====== Start Why Travel With Us ======-->
<section class="about-why" style="background-image: url('{{ asset('assets/images/service/sahra.jpeg') }}');">
    <div class="about-why-overlay"></div>

    <!-- Left decorative lines -->
    <div class="about-why-lines lines-left">
        <svg viewBox="0 0 260 600" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
            <path d="M-40,40 C90,120 30,260 140,340 C210,390 190,500 90,590"
                  fill="none" stroke="#F7921E" stroke-width="6" stroke-linecap="round" opacity="0.95"/>
            <path d="M-10,0 C120,80 70,220 180,300 C240,340 230,470 140,560"
                  fill="none" stroke="#63AC45" stroke-width="4" stroke-linecap="round" opacity="0.9"/>
            <path d="M-70,90 C60,160 10,300 100,380 C170,430 160,540 60,620"
                  fill="none" stroke="#F7921E" stroke-width="3" stroke-linecap="round" opacity="0.6"/>
        </svg>
    </div>

    <!-- Right decorative lines -->
    <div class="about-why-lines lines-right">
        <svg viewBox="0 0 260 600" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
            <path d="M300,40 C170,120 230,260 120,340 C50,390 70,500 170,590"
                  fill="none" stroke="#F7921E" stroke-width="6" stroke-linecap="round" opacity="0.95"/>
            <path d="M270,0 C140,80 190,220 80,300 C20,340 30,470 120,560"
                  fill="none" stroke="#63AC45" stroke-width="4" stroke-linecap="round" opacity="0.9"/>
            <path d="M330,90 C200,160 250,300 160,380 C90,430 100,540 200,620"
                  fill="none" stroke="#F7921E" stroke-width="3" stroke-linecap="round" opacity="0.6"/>
        </svg>
    </div>

    <div class="container" style="position: relative; z-index: 3;">
        <div class="row align-items-center">
            <div class="col-lg-5 mb-30">
                <h2 class="about-why-title">{{ 'about_page.why_title'|trans }}</h2>
            </div>
            <div class="col-lg-7 mb-30">
                <ul class="about-why-list">
                    <li><i class="fas fa-check-circle"></i> {{ 'about_page.why_item1'|trans }}</li>
                    <li><i class="fas fa-check-circle"></i> {{ 'about_page.why_item2'|trans }}</li>
                    <li><i class="fas fa-check-circle"></i> {{ 'about_page.why_item3'|trans }}</li>
                    <li><i class="fas fa-check-circle"></i> {{ 'about_page.why_item4'|trans }}</li>
                    <li><i class="fas fa-check-circle"></i> {{ 'about_page.why_item5'|trans }}</li>
                    <li><i class="fas fa-check-circle"></i> {{ 'about_page.why_item6'|trans }}</li>
                </ul>
            </div>
        </div>
    </div>
</section>
<!--====== Start Emotional / Full Width Section ======-->
<section class="about-emotional">
    <div class="container">
        <div class="about-emotional-card" style="background-image: url('{{ asset('assets/images/bg/cta-bg-1.png') }}');">
            <div class="about-emotional-content text-center">
                <h2 class="about-emotional-quote">{{ 'about_page.emotional_quote'|trans }}</h2>
                <p class="about-emotional-question">{{ 'about_page.emotional_question'|trans }}</p>
                <a href="{{ path('app_font_circuits') }}" class="about-emotional-btn">
                    <i class="fas fa-mountain"></i>
                    {{ 'about_page.emotional_button'|trans }}
                </a>
            </div>
        </div>
    </div>
</section>
<!--====== End Emotional Section ======-->
{% endblock %}
    <style>
        /* =========================================
           Photo Mosaic / Collage Styling
           ========================================= */
        .photo-mosaic {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
            grid-auto-rows: 110px;
            gap: 6px; 
            width: 100%;
        }

        .mosaic-item {
            position: relative;
            overflow: hidden;
            border-radius: 12px;
            box-shadow: 0px 4px 15px rgba(59, 40, 28, 0.15);
            background-color: #f9f6f0;
        }

        .mosaic-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.4s ease, filter 0.4s ease;
        }

        .mosaic-item:hover img {
            transform: scale(1.08);
            filter: brightness(0.9);
        }

        /* Sizing Classes */
        .mosaic-item.large {
            grid-column: span 3;
            grid-row: span 3;
        }

        .mosaic-item.wide {
            grid-column: span 2;
        }

        .mosaic-item.tall {
            grid-row: span 2;
        }

        /* Responsive tweaks for mobile */
        @media (max-width: 768px) {
            .photo-mosaic {
                grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
                grid-auto-rows: 80px;
                gap: 4px;
            }
            .mosaic-item.large {
                grid-column: span 2;
                grid-row: span 2;
            }
        }
    </style>


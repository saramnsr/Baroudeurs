                        <h2 class="detail-section-heading" style="display:inline-block;">{{ 'gallery.video_title'|trans }}</h2>
                    </div>
                </div>
                <div class="row justify-content-center">
                    <div class="col-12">
                        <video id="gallery-auto-video" muted playsinline loop style="width:100%; max-height:85vh; object-fit:cover; border-radius:14px; box-shadow:0px 10px 60px rgba(59,40,28,0.15);">
                           <source src="https://res.cloudinary.com/dy13axswo/video/upload/v1788699280/baroudeurs/videos/desert-4x4-tour.mp4" type="video/mp4">
                        </video>
                    </div>
                </div>
            </div>
        </section><!--====== End Video Section ======-->

{% extends 'base.html.twig' %}

{% block title %}{{ 'gallery.title'|trans }}{% endblock %}

{% block body %}
    <style>
        /* ===== Gallery card image + hover overlay — locked to image size ===== */
        .gallery-row .single-gallery-item .gallery-img {
            position: relative;
            overflow: hidden;
            border-radius: 8px;
            display: block;
            line-height: 0;
            width: 100%;
        }
        .gallery-row .single-gallery-item .gallery-img > a {
            display: block;
            position: relative;
            width: 100%;
            height: 300px;
            overflow: hidden;
        }
        .gallery-row .single-gallery-item .gallery-img > a > img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .gallery-row .single-gallery-item .gallery-img .hover-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            width: 100%; height: 100%;
            background-color: rgba(28, 35, 31, 0.4);
            visibility: hidden; opacity: 0;
            transition: all 0.3s ease-out 0s;
            z-index: 1;
            pointer-events: none;
        }
        .gallery-row .single-gallery-item .gallery-img .hover-content {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            width: 100%; height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            visibility: hidden; opacity: 0;
            transition: all 0.4s ease-out 0s;
            z-index: 2;
            pointer-events: none;
        }
        .gallery-row .single-gallery-item .gallery-img .hover-content .icon-btn {
            width: 70px; height: 70px;
            border-radius: 50%;
            background-color: #C96B3C;
            color: #E8D0A8;
            display: flex;
            align-items: center;
            justify-content: center;
            transform: translateY(30px);
            transition: all 0.5s ease-out 0s;
        }
        .gallery-row .single-gallery-item:hover .gallery-img .hover-overlay {
            visibility: visible; opacity: 1;
        }
        .gallery-row .single-gallery-item:hover .gallery-img .hover-content {
            visibility: visible; opacity: 1;
        }
        .gallery-row .single-gallery-item:hover .gallery-img .hover-content .icon-btn {
            transform: translateY(0);
        }
    </style>

    <section class="page-banner light-red-bg pt-170 pb-170 bg_cover" style="background-image: url('{{ asset('assets/images/bg/bg-gal.jpg') }}');">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="page-banner-content text-center text-white">
                        <h1 class="page-title">{{ 'gallery.title'|trans }}</h1>
                        <ul class="breadcrumb-link text-white">
                            <li><a href="{{ path('app_font_index') }}">{{ 'gallery.breadcrumb_home'|trans }}</a></li>
                            <li class="active">{{ 'gallery.title'|trans }}</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section><!--====== End Breadcrumb Section ======-->

    <!--====== Start Gallery Section ======-->
    <section class="gallery-section pt-100 pb-60">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="gallery-filter-button text-center mb-60 wow fadeInDown">
                        <ul class="gallery-btn">
                            <li class="active" data-filter="*">{{ 'gallery.filter.all'|trans }}</li>
                            <li data-filter=".cat-desert">{{ 'gallery.filter.desert'|trans }}</li>
                            <li data-filter=".cat-douz">{{ 'gallery.filter.douz'|trans }}</li>
                            <li data-filter=".cat-djerba">{{ 'gallery.filter.djerba'|trans }}</li>
                            <li data-filter=".cat-oasis">{{ 'gallery.filter.oasis'|trans }}</li>
                            <li data-filter=".cat-bivouac">{{ 'gallery.filter.bivouac'|trans }}</li>
                            <li data-filter=".cat-meeting">{{ 'gallery.filter.starwars'|trans }}</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="row gallery-row">
                {% if galleryFolders is empty %}
                    <div class="col-12 text-center">
                        <p>No images found in Cloudinary gallery folder.</p>
                    </div>
                {% else %}
                    {% for folder in galleryFolders %}
                        <div class="col-lg-4 col-md-6 col-sm-12 gallery-column {{ folder.class }}">
                            <div class="single-gallery-item mb-25 wow fadeInUp">
                                <div class="gallery-img">
                                    <a href="{{ folder.coverImage }}"
                                       class="gallery-folder-open"
                                       data-gallery-id="gallery-{{ loop.index }}"
                                       title="{{ folder.caption|trans }}">
                                        <img src="{{ folder.coverImage }}" alt="{{ folder.caption|trans }}">
                                        <div class="hover-overlay"></div>
                                        <div class="hover-content">
                                            <span class="icon-btn"><i class="far fa-search-plus"></i></span>
                                        </div>
                                    </a>

                                    {# Hidden: all images of this folder for the popup gallery #}
                                    <div id="gallery-{{ loop.index }}" style="display:none;">
                                        {% for img in folder.images %}
                                            <a href="{{ img }}" title="{{ folder.caption|trans }}"></a>
                                        {% endfor %}
                                    </div>
                                </div>
                                <div class="gallery-content">
                                    <h4 class="title">{{ folder.caption|trans }}</h4>
                                    <span class="cat-link">{{ folder.filter|trans }}</span>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </section><!--====== End Gallery Section ======-->

    <!--====== Start Video Section ======-->
    <section class="pt-40 pb-100">
        <div class="container-fluid">
            <div class="row justify-content-center mb-40">
                <div class="col-lg-8 text-center">
                    <h2 class="detail-section-heading" style="display:inline-block;">{{ 'gallery.video_title'|trans }}</h2>
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-12">
                    <video id="gallery-auto-video" muted playsinline loop style="width:100%; max-height:85vh; object-fit:cover; border-radius:14px; box-shadow:0px 10px 60px rgba(59,40,28,0.15);">
                        <source src="https://res.cloudinary.com/dy13axswo/video/upload/v1788699280/baroudeurs/videos/desert-4x4-tour.mp4" type="video/mp4">
                    </video>
                </div>
            </div>
        </div>
    </section><!--====== End Video Section ======-->
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            var video = document.getElementById('gallery-auto-video');
            if (video) {
                var observer = new IntersectionObserver(function(entries) {
                    entries.forEach(function(entry) {
                        if (entry.isIntersecting) { video.play(); }
                        else { video.pause(); }
                    });
                }, { threshold: 0.5 });
                observer.observe(video);
            }

            $('.gallery-folder-open').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();

                var galleryId = $(this).data('gallery-id');
                var items = [];

                $('#' + galleryId + ' a').each(function() {
                    items.push({
                        src: $(this).attr('href'),
                        title: $(this).attr('title')
                    });
                });

                $.magnificPopup.open({
                    items: items,
                    type: 'image',
                    gallery: { enabled: true },
                    image: { titleSrc: 'title' }
                });

                return false;
            });
        });
    </script>
{% endblock %}
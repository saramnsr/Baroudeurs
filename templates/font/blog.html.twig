    <!--====== Start Featured Guide / Second Section ======-->
    <section class="cr-story">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-5 mb-40 mb-lg-0">
                    <div class="cr-story-content">
                        <span class="cr-eyebrow">{{ 'blog_page.featured_eyebrow'|trans }}</span>
                        
                        <h2 class="cr-title-lg">
                            How to prepare<br>
                            for your first trip<br>
                            into the Tunisian desert?
                        </h2>

                        <div class="cr-story-tags">
                            <span class="cr-pill"><i class="fas fa-route"></i> Itinerary</span>
                            <span class="cr-pill"><i class="fas fa-clock"></i> Duration</span>
                            <span class="cr-pill"><i class="fas fa-car"></i> Transport</span>
                            <span class="cr-pill"><i class="fas fa-campground"></i> Bivouac</span>
                            <span class="cr-pill"><i class="fas fa-sun"></i> Best season</span>

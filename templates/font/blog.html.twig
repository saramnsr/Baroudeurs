    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var tabs = document.querySelectorAll('.cr-tab');
            var grid = document.getElementById('crBentoGrid');
            var cards = document.querySelectorAll('#cr-grid .cr-bento-item');

            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    tabs.forEach(function (t) { t.classList.remove('active'); });
                    tab.classList.add('active');
                    var target = tab.getAttribute('data-tab');

                    if (target === 'tous') {
                        grid.classList.remove('cr-bento-filtered');
                    } else {
                        grid.classList.add('cr-bento-filtered');
                    }

                    cards.forEach(function (item) {
                        var show = (target === 'tous' || item.getAttribute('data-cat') === target);
                        item.style.display = show ? '' : 'none';
                    });
                });
            });

            var track = document.getElementById('crLatestTrack');
            var prevBtn = document.querySelector('.cr-latest-arrow--prev');
            var nextBtn = document.querySelector('.cr-latest-arrow--next');

            if (track && prevBtn && nextBtn) {
                var scrollAmount = function () {
                    var card = track.querySelector('.cr-latest-card');
                    return card ? card.offsetWidth + 24 : 300;
                };
                prevBtn.addEventListener('click', function () {
                    track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
                });
                nextBtn.addEventListener('click', function () {
                    track.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
                });
            }
        });
    </script>

{% endblock %}
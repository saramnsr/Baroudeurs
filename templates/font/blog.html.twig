            <a href="#cr-grid" class="services-hero-location" data-filter="tataouine">{{ 'blog_page.hero_tag_tataouine'|trans }}</a>
        </div>
    </div>

    <div class="services-hero-wave">
        <svg viewBox="0 0 1440 140" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,70 C240,120 480,20 720,60 C960,100 1200,130 1440,70 L1440,140 L0,140 Z" fill="#F6F2E9"></path>
        </svg>
    </div>
</section>

<!--====== Start Carnet de Route Hero ======-->
<section class="services-hero" id="crHero">
    <div class="services-hero-slides">
        <div class="services-hero-slide active" style="background-image: url('{{ asset('assets/images/blog/new-blog/hero1.jpg') }}');"></div>
    </div>
    <div class="services-hero-overlay"></div>

    <div class="container" style="position: relative; z-index: 3;">
        <div class="services-hero-content text-start">
            <span class="services-hero-label">
                <span class="label-line"></span>
                {{ 'blog_page.hero_eyebrow'|trans|upper }}
            </span>
            <h1 class="services-hero-title">
                {{ 'blog_page.hero_title_line1'|trans }}<br>
                {{ 'blog_page.hero_title_line2'|trans }}
            </h1>
            <p class="services-hero-text">{{ 'blog_page.hero_text'|trans }}</p>
            <a href="#cr-grid" class="services-hero-btn">
                {{ 'blog_page.hero_cta'|trans }}
                <i class="far fa-angle-double-right"></i>
            </a>
        </div>

        <div class="services-hero-locations">
            <a href="#cr-grid" class="services-hero-location" data-filter="douz">{{ 'blog_page.hero_tag_douz'|trans }}</a>
            <a href="#cr-grid" class="services-hero-location" data-filter="sahara">{{ 'blog_page.hero_tag_sahara'|trans }}</a>
            <a href="#cr-grid" class="services-hero-location" data-filter="djerba">{{ 'blog_page.hero_tag_djerba'|trans }}</a>

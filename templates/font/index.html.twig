    <section class="banner-section">
        <div class="hero-wrapper-one p-r z-1">
            <div class="hero-dots"></div>
            <div class="hero-slider-one-nav">
                <button type="button" class="hero-nav-btn prev" aria-label="Previous slide"><i class="fal fa-chevron-left"></i></button>
                <button type="button" class="hero-nav-btn next" aria-label="Next slide"><i class="fal fa-chevron-right"></i></button>
            </div>
            <div class="hero-slider-one">
                <!--====== Single Slider 1 ======-->
                <div class="single-slider p-r z-1" data-title={{ 'hero.sub'|trans }}>
                    <div class="image-layer bg_cover" style="background-image: url({{ asset('assets/images/hero/hero-slider-one.jpg') }});"></div>
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-8">
                                <div class="hero-content text-white text-center">
                                    <span class="sub-title" data-animation="fadeInDown" data-delay=".4s"><span class="number">01</span>{{ 'hero.sub'|trans }}</span>
                                    <h1 data-animation="fadeInUp" data-delay=".6s">{{ 'hero.main_title'|trans }}</h1>
                                    <p class="text-white" data-animation="fadeInUp" data-delay=".7s">{{ 'hero.main_subtitle'|trans }}</p>
                                    <div class="hero-button" data-animation="fadeInDown" data-delay=".8s">
                                        <a href="{{ path('app_font_circuits') }}" class="main-btn btn-yellow">{{ 'hero.btn1'|trans }}<i class="far fa-angle-double-right"></i></a>
                                        <a href="{{ path('app_font_contact') }}" class="main-btn btn-link">{{ 'hero.btn2'|trans }}<i class="far fa-angle-double-right"></i></a>
                                    </div>
                                </div>
                            </div>

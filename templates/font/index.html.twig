<!--====== Start Excursions Section ======-->
    <section class="excursions-section pt-40 pb-100" id="excursions">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-7 col-lg-10">
                    <div class="section-title text-center mb-50 wow fadeInDown">
                        <span class="sub-title">
                            <span class="number">03</span>{{ 'excursions.subtitle'|trans }}
                        </span>
                        <h2>
                            {{ 'excursions.title'|trans }}
                            <span class="thin">{{ 'excursions.title2'|trans }}</span>
                        </h2>
                    </div>
                </div>
            </div>

            <div class="excursion-grid">
                {% for excursion in featuredExcursions %}
                    <a href="{{ path('programme_detail', {'id': excursion.id}) }}" class="excursion-card {{ loop.index <= 2 ? 'excursion-card-large' : 'excursion-card-small' }}">
                        <img class="excursion-card-bg"
                             src="{{ excursion.image starts with 'http' ? excursion.image : asset('assets/images/' ~ excursion.image) }}"
                             alt=""
                             loading="lazy"
                             decoding="async">
                        <div class="excursion-card-overlay"></div>
                        <div class="excursion-card-shine"></div>
                        <div class="excursion-compass-badge"><i class="fas fa-compass"></i></div>
                        <div class="excursion-card-content">
                            <h3>
                                {% if locale == 'fr' %}{{ excursion.titleFr }}
                                {% elseif locale == 'ar' %}{{ excursion.titleAr }}
                                {% elseif locale == 'it' %}{{ excursion.titleIt }}
                                {% else %}{{ excursion.titleEn }}
                                {% endif %}
                            </h3>
                            <span class="excursion-card-subtitle">
                                <i class="far fa-clock"></i>
                                {% if locale == 'fr' %}{{ excursion.dureeFr }}
                                {% elseif locale == 'ar' %}{{ excursion.dureeAr }}
                                {% elseif locale == 'it' %}{{ excursion.dureeIt }}
                                {% else %}{{ excursion.dureeEn }}
                                {% endif %}
                            </span>
                        </div>
                        <span class="excursion-discover-btn">{{ 'excursions.discover'|trans }}</span>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section><!--====== End Excursions Section ======-->

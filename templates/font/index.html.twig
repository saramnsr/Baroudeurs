{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                if (window.jQuery) {
                    var $slider = jQuery('.hero-slider-one');

                    // Speed up autoplay without reinitializing the whole slider
                    if ($slider.hasClass('slick-initialized')) {
                        $slider.slick('slickSetOption', 'autoplaySpeed', 2200, true);
                    }

                    jQuery('.hero-nav-btn.prev').on('click', function () {
                        $slider.slick('slickPrev');
                    });
                    jQuery('.hero-nav-btn.next').on('click', function () {
                        $slider.slick('slickNext');
                    });
                }
            }, 300);
        });
    </script>


    <script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.flash-close').forEach(function (btn) {
            btn.addEventListener('click', function () {
                btn.closest('.site-flash-message').remove();
            });
        });
        document.querySelectorAll('.site-flash-message').forEach(function (el) {
            setTimeout(function () {
                el.style.transition = 'opacity 0.4s ease-out';
                el.style.opacity = '0';
                setTimeout(function () { el.remove(); }, 400);
            }, 5000);
        });
    });
</script>


<script>
    document.addEventListener('DOMContentLoaded', function () {
        var slider = document.querySelector('.showcase-slider');
        if (slider) {
            var scrollAmount = 1;
            var scrollSpeed = 20; // ms between steps — lower = faster
            var autoScroll = setInterval(function () {
                if (slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 1) {
                    slider.scrollLeft = 0; // loop back to start
                } else {
                    slider.scrollLeft += scrollAmount;
                }
            }, scrollSpeed);

            // Pause on hover, resume on mouse leave
            slider.addEventListener('mouseenter', function () {
                clearInterval(autoScroll);
            });
            slider.addEventListener('mouseleave', function () {
                autoScroll = setInterval(function () {
                    if (slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 1) {
                        slider.scrollLeft = 0;
                    } else {
                        slider.scrollLeft += scrollAmount;
                    }
                }, scrollSpeed);
            });
        }
    });
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var track = document.querySelector('.testimonial-slider-track');
  var slides = document.querySelectorAll('.testimonial-slide');
  if (!track || slides.length <= 1) return;

  var current = 0;
  var total = slides.length;

  setInterval(function () {
    current = (current + 1) % total;
    track.style.transform = 'translateX(-' + (current * 100) + '%)';
  }, 6000);
});
</script>

{% extends 'base.html.twig' %}

{% block title %}Excursions - Baroudeurs du Désert{% endblock %}

{% block body %}

    <!--====== Start Page Banner ======-->
    <section class="page-banner-section" style="background-image: url('{{ asset('assets/images/bg/bg-4.jpg') }}');">
        <div class="container">
            <div class="page-banner-content text-center">
                <h1 class="page-title">Excursions</h1>
                <ul class="page-breadcrumb">
                    <li><a href="{{ path('app_font_index') }}">Home</a></li>
                    <li><span class="separator"><i class="fas fa-chevron-right"></i></span></li>
                    <li class="active">Excursions</li>
                </ul>
            </div>
        </div>
        <!-- Wavy bottom -->
        <div class="banner-wave">
            <svg viewBox="0 0 1440 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0,40 C240,120 480,0 720,60 C960,120 1200,20 1440,70 L1440,120 L0,120 Z" fill="#ffffff"/>
            </svg>
        </div>
    </section>
    <!--====== End Page Banner ======-->

    <!--====== Start Excursions Zigzag Section ======-->
    <section class="excursions-zigzag-section pt-100 pb-100">
        <div class="excursions-zigzag-wrapper">
            {% for excursion in excursions %}
                <div class="excursion-zigzag-item {{ loop.index is odd ? 'excursion-normal' : 'excursion-reverse' }}">
                    <div class="excursion-zigzag-image">
                        <img src="{{ excursion.image }}" alt="{{ excursion.getTitle(app.request.locale) }}">
                    </div>
                    <div class="excursion-zigzag-card">
                        <span class="excursion-zigzag-number">{{ '%02d'|format(loop.index) }}</span>
                        {% if excursion.getDuration(app.request.locale) %}
                            <span class="excursion-zigzag-duration">{{ excursion.getDuration(app.request.locale) }}</span>
                        {% endif %}
                        <div class="excursion-zigzag-title-row">
                            <span class="excursion-zigzag-line"></span>
                            <h3 class="excursion-zigzag-title">{{ excursion.getTitle(app.request.locale) }}</h3>
                        </div>
                        <p class="excursion-zigzag-desc">{{ excursion.getDescription(app.request.locale) }}</p>
                        <div class="excursion-zigzag-features">
                            {% for item in excursion.getIncluded(app.request.locale)|slice(0, 3) %}
                                <div class="excursion-feature">
                                    <i class="{{ ['fas fa-utensils', 'fas fa-campground', 'fas fa-shuttle-van'][loop.index0 % 3] }}"></i>
                                    <span>{{ item }}</span>
                                </div>
                            {% endfor %}
                        </div>
                        <a href="{{ path('app_font_detail', {type: 'excursion', id: excursion.id}) }}" class="excursion-zigzag-btn">
                            {{ 'circuits_page.more_details'|trans }} <i class="fas fa-angle-double-right"></i>
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
    <!--====== End Excursions Zigzag Section ======-->

    <style>
        /* Banner wave positioning */
        .page-banner-section {
            position: relative;
            overflow: hidden;
        }
        .banner-wave {
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            line-height: 0;
            z-index: 2;
            pointer-events: none;
        }
        .banner-wave svg {
            display: block;
            width: 100%;
            height: 80px;
        }

        /* Make the text stay green on hover with !important */
        .excursion-zigzag-btn:hover,
        .excursion-zigzag-btn:focus,
        .excursion-zigzag-btn:active {
            color: #ffffff !important;
        }
    </style>

{% endblock %}
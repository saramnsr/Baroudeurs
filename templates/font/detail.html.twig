    <!--====== Start Detail Main Section ======-->
    <section class="detail-main-section pt-40 pb-60">
        <div class="container">
            <div class="row">
                <!-- Main content -->
                <div class="col-lg-8">
                    <h1 class="detail-page-title">{{ title }}</h1>
                    {% if intro %}
                        <p class="detail-full-desc">{{ intro }} {{ fullDescription }}</p>
                    {% else %}
                        <p class="detail-full-desc">{{ fullDescription }}</p>
                    {% endif %}

                    <h3 class="detail-section-title">{{ 'detail_page.itinerary_title'|trans }}</h3>
                    {% if itinerarySummary %}
                        <p class="detail-itinerary-summary">{{ itinerarySummary }}</p>
                    {% endif %}
                    <div class="detail-itinerary-accordion">
                        {% for day in itineraryList %}
                            <details class="itinerary-item">
                                <summary>
                                    <span class="day-badge">{{ 'detail_page.day'|trans }} {{ loop.index }}</span>
                                    {{ day }}
                                    <i class="fas fa-chevron-down toggle-icon"></i>
                                </summary>
                                {% if itineraryDetailList[loop.index0] is defined and itineraryDetailList[loop.index0] %}
                                    <div class="itinerary-detail">{{ itineraryDetailList[loop.index0] }}</div>
                                {% endif %}
                            </details>
                        {% endfor %}
                    </div>

                    {% if includedList|length > 0 or excludedList|length > 0 %}
                        <h3 class="detail-section-title">{{ 'detail_page.included_options_title'|trans }}</h3>
                        <div class="equipment-table-wrap {{ excludedList|length == 0 ? 'single-col' : '' }}">
                            {% if includedList|length > 0 %}
                                <div class="equipment-col">
                                    <div class="equipment-col-header">{{ 'detail_page.included_title'|trans }}</div>
                                    <div class="equipment-rows-grid">
                                        {% for i in 0..(includedList|length - 1) %}
                                            <div class="equipment-row">
                                                <i class="flaticon-{{ item.includedIcons[i] is defined ? item.includedIcons[i] : 'draw-check-mark' }}"></i>
                                                <span>{{ includedList[i] }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                            {% if excludedList|length > 0 %}
                                <div class="equipment-col">
                                    <div class="equipment-col-header">{{ 'detail_page.excluded_title'|trans }}</div>
                                    <div class="equipment-rows-grid">
                                        {% for i in 0..(excludedList|length - 1) %}
                                            <div class="equipment-row">
                                                <i class="flaticon-{{ item.excludedIcons[i] is defined ? item.excludedIcons[i] : 'quotation' }}"></i>
                                                <span>{{ excludedList[i] }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>

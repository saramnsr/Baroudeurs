                        <div class="booking-field">
                            <span>{{ 'detail_page.guest'|trans }}</span>
                            <input type="number" min="1" class="booking-input" name="guests" placeholder="{{ 'detail_page.number_of_people'|trans }}" required>
                            <i class="fas fa-user booking-field-icon"></i>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="booking-field">
                            <span>{{ 'detail_page.full_name'|trans }}</span>
                            <input type="text" class="booking-input" name="name" placeholder="{{ 'detail_page.full_name'|trans }}" required>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="booking-field">
                            <span>{{ 'detail_page.your_email'|trans }}</span>
                            <input type="email" class="booking-input" name="email" placeholder="{{ 'detail_page.your_email'|trans }}" required>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <button type="submit" class="booking-submit-btn">
                            {{ 'detail_page.check_availability'|trans }} <i class="far fa-angle-double-right"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>
    <!--====== End Circuit Booking Card ======-->

    <!--====== Start Related Circuits ======-->
    <section class="related-circuits-section pt-100 pb-100">
        <div class="container">
            <div class="row justify-content-center mb-50">
                <div class="col-lg-6 text-center">
                    <h2 class="related-title">{{ (type == 'excursion' ? 'detail_page.other_excursions' : 'detail_page.other_circuits')|trans }}</h2>
                </div>
            </div>
            <div class="row">
                {% for related in relatedItems %}
                    {% set relatedTitle = related.title[locale] is defined ? related.title[locale] : related.title.en %}
                    {% set relatedDescription = related.description[locale] is defined ? related.description[locale] : related.description.en %}
                    <div class="col-lg-4 col-md-6 mb-40">
                        <div class="related-card">
                            <div class="related-card-image">
                                <img src="{{ related.image starts with 'http' ? related.image : asset('assets/images/' ~ related.image) }}" alt="{{ relatedTitle }}" loading="lazy" decoding="async">
                            </div>
                            <div class="related-card-content">
                                <div class="related-card-title-row">
                                    <span class="related-card-line"></span>
                                    <h4>{{ relatedTitle }}</h4>
                                </div>
                                <p>{{ relatedDescription }}</p>
                                <div class="related-card-bottom">
                                    <div class="related-card-icons">
                                        {% for icon in related.icons|slice(0, 4) %}
                                            <i class="{{ icon }}"></i>
                                        {% endfor %}
                                    </div>
                                    <a href="{{ path('app_font_detail', {type: type, id: related.id}) }}" class="related-card-btn" aria-label="{{ relatedTitle }}">
                                        <i class="fas fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
    <!--====== End Related Circuits ======-->

    {% endif %}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var checkInInput = document.getElementById('circuitCheckInInput');

            document.querySelectorAll('.mini-calendar-table td[data-date]').forEach(function (cell) {
                cell.addEventListener('click', function () {
                    var iso = cell.getAttribute('data-date');
                    var parts = iso.split('-');
                    var formatted = parts[2] + '/' + parts[1] + '/' + parts[0];

                    if (checkInInput) {
                        checkInInput.value = formatted;
                        checkInInput.dispatchEvent(new Event('input', { bubbles: true }));
                        checkInInput.dispatchEvent(new Event('change', { bubbles: true }));
                    }

                    document.querySelectorAll('.mini-calendar-table td.today').forEach(function (el) {
                        el.classList.remove('today');
                    });
                    cell.classList.add('today');
                });
            });

            var bookNowBtn = document.getElementById('sidebarBookNowBtn');
            if (bookNowBtn) {
                bookNowBtn.addEventListener('click', function (e) {
                    var target = document.getElementById('availability-section');
                    if (target) {
                        e.preventDefault();
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            }
        });
    </script>
{% endblock %}
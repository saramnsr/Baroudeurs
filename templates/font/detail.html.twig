    {#
        The page is reached via /detail/{type}/{id}. Pull those two
        route values straight from the request so this template does
        not depend on the controller passing the right `item`/`type`
        variables — it looks itself up in the array matching `type`.
    #}
    {% set type = _detailType %}
    {% set locale = app.request.locale %}
    {% set dataset = type == 'excursion' ? excursionData : circuitData %}
    {% set matches = dataset|filter(i => i.id == _detailId) %}
    {% set item = matches|first %}

    {% set title = item is not null ? (item.title[locale] is defined ? item.title[locale] : item.title.en) : '' %}


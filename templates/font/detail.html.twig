{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var checkInInput = document.getElementById('circuitCheckInInput');

            document.querySelectorAll('.mini-calendar-table td[data-date]').forEach(function (cell) {
                cell.addEventListener('click', function () {
                    var iso = cell.getAttribute('data-date');
                    var parts = iso.split('-');
                    var formatted = parts[2] + '/' + parts[1] + '/' + parts[0];

                    if (checkInInput) {
                        checkInInput.value = formatted;
                        checkInInput.dispatchEvent(new Event('input', { bubbles: true }));
                        checkInInput.dispatchEvent(new Event('change', { bubbles: true }));
                    }

                    document.querySelectorAll('.mini-calendar-table td.today').forEach(function (el) {
                        el.classList.remove('today');
                    });
                    cell.classList.add('today');
                });
            });

            var bookNowBtn = document.getElementById('sidebarBookNowBtn');
            if (bookNowBtn) {
                bookNowBtn.addEventListener('click', function (e) {
                    var target = document.getElementById('availability-section');
                    if (target) {
                        e.preventDefault();
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            }
        });
    </script>
{% endblock %}
{% extends 'admin/admin_layout.html.twig' %}

{% block title %}{{ labels.trash_title }}{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-header__row">
            <div>
                <h1 class="admin-page-header__title">{{ labels.trash_title }}</h1>
                <p class="admin-page-header__subtitle">
                    {{ items|length }} {{ items|length > 1 ? 'éléments' : 'élément' }} dans la corbeille
                </p>
            </div>
            <a class="admin-btn admin-btn--ghost" href="{{ path('admin_trip_index', {type: type}) }}">
                <i class="fas fa-arrow-left" aria-hidden="true"></i> Retour à la liste
            </a>
        </div>
    </div>

    {% if items|length == 0 %}
        <div class="admin-card admin-empty">
            <i class="fas fa-trash-alt admin-empty__icon" aria-hidden="true"></i>
            <h2 class="admin-empty__title">La corbeille est vide</h2>
            <p class="admin-empty__text">Les éléments supprimés apparaîtront ici.</p>
        </div>
    {% else %}
        {# Barre de recherche #}
        <div class="admin-search" data-search-bar>
            <i class="fas fa-search admin-search__icon" aria-hidden="true"></i>
            <input
                type="search"
                class="admin-search__input"
                placeholder="Rechercher par titre…"
                aria-label="Rechercher dans la corbeille"
                data-search-input
                autocomplete="off">
            <button type="button" class="admin-search__clear" data-search-clear hidden
                    aria-label="Effacer la recherche">
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
        </div>

        <p class="admin-search__count" data-search-count hidden></p>

        <div class="admin-trip-grid" data-search-list>
            {% for item in items %}
                <article class="admin-trip-card admin-trip-card--trashed"
                         data-search-item
                         data-title="{{ item.titleFr|lower }}">
                    <div class="admin-trip-card__media">
                        {% if item.image starts with 'http' %}
                            <img src="{{ item.image }}" alt="{{ item.titleFr }}" loading="lazy" decoding="async">
                        {% else %}
                            <img src="{{ asset('assets/images/' ~ item.image) }}" alt="{{ item.titleFr }}" loading="lazy" decoding="async">
                        {% endif %}
                        <span class="admin-trip-card__badge">Corbeille</span>
                    </div>

                    <div class="admin-trip-card__body">
                        <h3 class="admin-trip-card__title">{{ item.titleFr }}</h3>
                        {% if item.durationFr %}
                            <p class="admin-trip-card__meta">
                                <i class="fas fa-calendar-alt" aria-hidden="true"></i>
                                {{ item.durationFr }}
                            </p>
                        {% endif %}
                        {% if item.deletedAt %}
                            <p class="admin-trip-card__date">
                                Supprimé le {{ item.deletedAt|date('d/m/Y à H:i') }}
                            </p>
                        {% endif %}
                    </div>

                    <div class="admin-trip-card__actions">
                        <form method="post"
                              action="{{ path('admin_trip_restore', {type: type, id: item.id}) }}"
                              class="admin-trip-card__form"
                              onsubmit="return confirm('Restaurer « {{ item.titleFr|e('js') }} » ?');">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('admin_trip_restore_' ~ item.id) }}">
                            <button type="submit" class="admin-btn admin-btn--ghost admin-btn--sm"
                                    title="Restaurer">
                                <i class="fas fa-undo" aria-hidden="true"></i> Restaurer
                            </button>
                        </form>

                        <form method="post"
                              action="{{ path('admin_trip_purge', {type: type, id: item.id}) }}"
                              class="admin-trip-card__form"
                              onsubmit="return confirm('Supprimer DÉFINITIVEMENT « {{ item.titleFr|e('js') }} » ?\n\nCette action est irréversible et supprimera aussi les images sur Cloudinary.');">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('admin_trip_purge_' ~ item.id) }}">
                            <button type="submit" class="admin-btn admin-btn--danger-ghost admin-btn--sm"
                                    title="Supprimer définitivement">
                                <i class="fas fa-trash-alt" aria-hidden="true"></i> Supprimer définitivement
                            </button>
                        </form>
                    </div>
                </article>
            {% endfor %}
        </div>

        {# Message si aucun résultat #}
        <div class="admin-card admin-empty" data-search-empty hidden>
            <i class="fas fa-search admin-empty__icon" aria-hidden="true"></i>
            <h2 class="admin-empty__title">Aucun résultat</h2>
            <p class="admin-empty__text">Essayez un autre terme de recherche.</p>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var bar = document.querySelector('[data-search-bar]');
            if (!bar) return;

            var input    = bar.querySelector('[data-search-input]');
            var clearBtn = bar.querySelector('[data-search-clear]');
            var list     = document.querySelector('[data-search-list]');
            var empty    = document.querySelector('[data-search-empty]');
            var countEl  = document.querySelector('[data-search-count]');
            var items    = list ? Array.prototype.slice.call(list.querySelectorAll('[data-search-item]')) : [];

            if (!input || !list || items.length === 0) return;

            // Normalise : minuscules + suppression des accents
            function normalize(str) {
                return (str || '')
                    .toString()
                    .toLowerCase()
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '');
            }

            function applyFilter() {
                var raw = input.value.trim();
                var q = normalize(raw);
                var visible = 0;

                items.forEach(function (card) {
                    var haystack = normalize(card.getAttribute('data-title'));
                    var match = q === '' || haystack.indexOf(q) !== -1;
                    card.hidden = !match;
                    if (match) visible++;
                });

                if (empty) empty.hidden = visible > 0;

                if (countEl) {
                    if (q === '') {
                        countEl.hidden = true;
                    } else {
                        countEl.hidden = false;
                        countEl.textContent = visible === 0
                            ? 'Aucun résultat'
                            : (visible + (visible > 1 ? ' résultats' : ' résultat'));
                    }
                }

                if (clearBtn) clearBtn.hidden = raw === '';
            }

            input.addEventListener('input', applyFilter);

            if (clearBtn) {
                clearBtn.addEventListener('click', function () {
                    input.value = '';
                    input.focus();
                    applyFilter();
                });
            }

            input.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    input.value = '';
                    applyFilter();
                }
            });

            applyFilter();
        });
    </script>
{% endblock %}
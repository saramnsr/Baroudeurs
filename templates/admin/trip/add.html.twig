{% extends 'admin/admin_layout.html.twig' %}
{% form_theme form 'admin/components/form_theme.html.twig' %}

{% block title %}{{ labels.add_title }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/fonts/flaticon/flaticon.css') }}">
{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <h1 class="admin-page-header__title">{{ labels.add_title }}</h1>
        <p class="admin-page-header__subtitle">Remplissez les informations en français : les traductions sont générées automatiquement.</p>
    </div>

    {{ form_start(form, {attr: {class: 'admin-form'}}) }}
        {{ form_errors(form) }}

        {# ===== 1. Images ===== #}
        <section class="admin-card">
            <h2 class="admin-card__title">Images</h2>
            <p class="admin-card__intro">
                Cliquez sur ★ pour choisir l'image principale (affichée sur la page {{ labels.plural|capitalize }}).
                Images 1 et 2 : en haut de la page détail. Les suivantes : bandeau défilant.
            </p>

            {{ form_errors(form.images) }}

            <label class="admin-dropzone" data-dropzone>
                {{ form_widget(form.images) }}
                <i class="fas fa-cloud-upload-alt admin-dropzone__icon" aria-hidden="true"></i>
                <strong>Glissez-déposez vos images ici</strong>
                <span>ou cliquez pour choisir · JPG, PNG, WebP · 10 Mo max par image</span>
            </label>

            <div class="admin-gallery" data-gallery></div>

            {{ form_widget(form.mainImageIndex) }}
            {{ form_widget(form.existingImages) }}
            {{ form_widget(form.mainImageKey) }}
        </section>

        {# ===== 2 à 5 : sections partagées ===== #}
        {% include 'admin/components/form_sections.html.twig' with {
            form: form,
            currentAvatarUrl: null
        } %}

        {# ===== Actions ===== #}
        <div class="admin-form__actions">
            <a class="admin-btn admin-btn--ghost" href="{{ path('admin_dashboard') }}">Annuler</a>
            <button type="submit" class="admin-btn admin-btn--primary">
                <i class="fas fa-save" aria-hidden="true"></i> Enregistrer
            </button>
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('[data-rating]').forEach(function (wrap) {
                var value = wrap.parentElement.querySelector('[data-rating-value]');
                function refresh() {
                    var checked = wrap.querySelector('input[type="radio"]:checked');
                    value.textContent = checked ? checked.value + '/5' : '';
                }
                wrap.addEventListener('change', refresh);
                refresh();
            });
        });
    </script>
{% endblock %}
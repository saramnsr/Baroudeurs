{% extends 'admin/admin_layout.html.twig' %}
{% form_theme form 'admin/components/form_theme.html.twig' %}

{% block title %}{{ labels.add_title }}{% endblock %}

{# Icônes flaticon (éléments "inclus") #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/fonts/flaticon/flaticon.css') }}">
{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <h1 class="admin-page-header__title">{{ labels.add_title }}</h1>
        <p class="admin-page-header__subtitle">Remplissez les informations en français : les traductions sont générées automatiquement.</p>
    </div>

    {{ form_start(form, {attr: {class: 'admin-form'}}) }}
        {{ form_errors(form) }}

        {# ===== 1. Images ===== #}
        <section class="admin-card">
            <h2 class="admin-card__title">Images</h2>
            <p class="admin-card__intro">
                Cliquez sur ★ pour choisir l'image principale (affichée sur la page {{ labels.list_page }}).
                Images 1 et 2 : en haut de la page détail. Les suivantes : bandeau défilant.
            </p>

            {{ form_errors(form.images) }}

            <label class="admin-dropzone" data-dropzone>
                {{ form_widget(form.images) }}
                <i class="fas fa-cloud-upload-alt admin-dropzone__icon" aria-hidden="true"></i>
                <strong>Glissez-déposez vos images ici</strong>
                <span>ou cliquez pour choisir · JPG, PNG, WebP · 10 Mo max par image</span>
            </label>

            <div class="admin-gallery" data-gallery></div>
            {{ form_widget(form.mainImageIndex) }}
        </section>

        {# ===== 2. Informations générales ===== #}
        <section class="admin-card">
            <h2 class="admin-card__title">Informations générales</h2>
            <div class="admin-form__grid admin-form__grid--2">
                {{ form_row(form.title) }}
                {{ form_row(form.duration) }}
            </div>
            {{ form_row(form.description) }}
            {{ form_row(form.fullDescription) }}
        </section>

        {# ===== 3. Itinéraire complet ===== #}
        <section class="admin-card">
            <h2 class="admin-card__title">Itinéraire complet</h2>
            {{ form_row(form.itinerarySummary) }}
            {% include 'admin/components/form_collection.html.twig' with {
                collection: form.itinerary,
                itemLabel: 'Jour',
                addLabel: 'Ajouter un jour'
            } %}
        </section>

        {# ===== 4. Ce qui est inclus ===== #}
        <section class="admin-card">
            <h2 class="admin-card__title">Ce qui est inclus</h2>
            <p class="admin-card__intro">Choisissez dans la liste, ou ajoutez un nouvel élément en bas de la liste (sans icône).</p>

            <div class="admin-form__grid admin-form__grid--2">
                <div class="admin-field">
                    <span class="admin-field__label">Inclus</span>
                    {% include 'admin/components/tag_picker.html.twig' with {
                        choices: form.includedItems,
                        custom: form.includedCustom,
                        placeholder: 'Choisir les éléments inclus…'
                    } %}
                </div>

                <div class="admin-field">
                    <span class="admin-field__label">Non inclus</span>
                    {% include 'admin/components/tag_picker.html.twig' with {
                        choices: form.excludedItems,
                        custom: form.excludedCustom,
                        placeholder: 'Choisir les éléments non inclus…'
                    } %}
                </div>
            </div>
        </section>

        {# ===== 5. Avis client ===== #}
        <section class="admin-card">
            <h2 class="admin-card__title">Avis client <span class="admin-card__optional">(optionnel)</span></h2>

            {# Photo du client #}
            <div class="admin-field{% if form.reviewAvatar.vars.errors|length > 0 %} has-error{% endif %}">
                <div class="admin-avatar" data-avatar>
                    <label class="admin-avatar__picker" title="Choisir une photo">
                        {{ form_widget(form.reviewAvatar, {attr: {class: 'admin-avatar__input', accept: 'image/jpeg,image/png,image/webp'}}) }}
                        <span class="admin-avatar__circle" data-avatar-preview>
                            <i class="fas fa-user" aria-hidden="true"></i>
                        </span>
                        <span class="admin-avatar__badge" aria-hidden="true"><i class="fas fa-camera"></i></span>
                    </label>
                    <div class="admin-avatar__info">
                        <strong data-avatar-title>Photo du client</strong>
                        <span>Cliquez sur le cercle · JPG, PNG ou WebP · format carré conseillé</span>
                        <button type="button" class="admin-btn admin-btn--danger-ghost admin-btn--sm" data-avatar-remove hidden>
                            <i class="fas fa-trash-alt" aria-hidden="true"></i> Retirer
                        </button>
                    </div>
                </div>
                {{ form_errors(form.reviewAvatar) }}
            </div>

            <div class="admin-form__grid admin-form__grid--2">
                {{ form_row(form.reviewName) }}
                {{ form_row(form.reviewCountry) }}
            </div>
            {{ form_row(form.reviewRating) }}
            {{ form_row(form.reviewComment) }}
        </section>

        {# ===== Actions ===== #}
        <div class="admin-form__actions">
            <a class="admin-btn admin-btn--ghost" href="{{ path('admin_dashboard') }}">Annuler</a>
            <button type="submit" class="admin-btn admin-btn--primary">
                <i class="fas fa-save" aria-hidden="true"></i> Enregistrer
            </button>
        </div>
    {{ form_end(form) }}
{% endblock %}
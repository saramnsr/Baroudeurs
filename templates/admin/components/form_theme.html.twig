{# Thème des formulaires admin : champ + aide + erreurs #}

{% block form_row %}
    {% set row_class = row_attr.class ?? '' %}
    <div class="admin-field {{ row_class }}{% if errors|length > 0 %} has-error{% endif %}">
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {% if help is not empty %}
            <small class="admin-field__help">{{ help }}</small>
        {% endif %}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="admin-field__errors">
            {% for error in errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
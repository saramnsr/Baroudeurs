{% extends 'admin/admin_base.html.twig' %}

{% block title %}Connexion{% endblock %}
{% block body_class %}admin-auth{% endblock %}

{% block body %}
    <main class="admin-auth__wrap">
        <div class="admin-auth__card">
            <img class="admin-auth__logo" src="{{ asset('assets/images/logo/main-logo.png') }}"
                 alt="Baroudeurs du Désert" height="56">

            <h1 class="admin-auth__title">Espace administration</h1>
            <p class="admin-auth__subtitle">Accès réservé au personnel autorisé.</p>

            {% if error %}
                <div class="admin-alert admin-alert--error" role="alert">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('admin_login') }}">
                <div class="admin-field">
                    <label for="email">Adresse email</label>
                    <input type="email" id="email" name="email" value="{{ last_username }}"
                           autocomplete="username" maxlength="180" required autofocus>
                </div>

                <div class="admin-field">
                    <label for="password">Mot de passe</label>
                    <div class="admin-field__password">
                        <input type="password" id="password" name="password"
                               autocomplete="current-password" required>
                        <button type="button" class="admin-field__reveal" data-password-toggle="password"
                                aria-label="Afficher le mot de passe" aria-pressed="false">
                            {# Icône œil (SVG inline : aucune librairie d'icônes à charger) #}
                            <svg class="icon-show" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg class="icon-hide" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                        </button>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="admin-btn admin-btn--primary admin-btn--block">Se connecter</button>
            </form>

            <a class="admin-auth__back" href="{{ path('app_font_index') }}">← Retour au site</a>
        </div>
    </main>
{% endblock %}
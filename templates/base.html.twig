        <!--====== Preloader Color Override ======-->
        <style>
            /* White background for the preloader */
            .preloader {
                background-color: #ffffff !important;
            }
            /* Orange for the loading animation */
            .preloader .loader .pre-box,
            .preloader .loader .pre-shadow {
                background-color: #F7921E !important;
            }
            /* In case the loader uses borders or pseudo-elements */
            .preloader .loader::before,
            .preloader .loader::after {
                background-color: #F7921E !important;
                border-color: #F7921E !important;
            }

            /* ===== Fixed/scrolled header: white background, black text =====
               Forced with !important because the header carries other
               theme classes (transparent-header, navigation-white) whose
               own rules would otherwise win. The scroll script below adds
               both "scrolled" and "sticky" once the user scrolls past the
               top, which is what triggers this block. */
            header.header-area .header-navigation.scrolled,
            header.header-area .header-navigation.sticky {
                background-color: #ffffff !important;
                box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08) !important;
            }
            header.header-area .header-navigation.scrolled .main-menu ul > li > a,
            header.header-area .header-navigation.sticky .main-menu ul > li > a {
                color: #1C231F !important;
            }
            header.header-area .header-navigation.scrolled .main-menu ul > li > a .dd-trigger,
            header.header-area .header-navigation.sticky .main-menu ul > li > a .dd-trigger {
                color: #1C231F !important;
            }
            header.header-area .header-navigation.scrolled .main-menu ul > li:hover > a,
            header.header-area .header-navigation.sticky .main-menu ul > li:hover > a {
                color: #8FAB45 !important;
            }
            header.header-area .header-navigation.scrolled .nav-right-item .nice-select,
            header.header-area .header-navigation.sticky .nav-right-item .nice-select,
            header.header-area .header-navigation.scrolled .nav-right-item .nice-select .current,
            header.header-area .header-navigation.sticky .nav-right-item .nice-select .current {
                color: #1C231F !important;
            }
            header.header-area .header-navigation.scrolled .navbar-toggler,
            header.header-area .header-navigation.sticky .navbar-toggler {
                border-color: rgba(0, 0, 0, 0.15) !important;
            }
            header.header-area .header-navigation.scrolled .navbar-toggler span,
            header.header-area .header-navigation.sticky .navbar-toggler span {
                background-color: #1C231F !important;
            }

            /* ===== Circuits / Excursions nav dropdowns =====
               The theme's base CSS has a generic rule
               ".main-menu ul > li { display: inline-block }" that also
               matches these li's since they sit under ".main-menu ul"
               too (nested). Every property below is forced with
               !important specifically to beat that rule and guarantee
               a plain white panel with one name per line. */
            .header-navigation .main-menu ul > li.menu-item-has-children > a .dd-trigger {
                margin-inline-start: 6px;
                font-size: 12px;
            }
            .header-navigation .main-menu ul.sub-menu {
                display: block !important;
                background-color: #ffffff !important;
                min-width: 300px;
                width: max-content;
                max-width: 360px;
                max-height: 360px;
                overflow-y: auto;
                padding: 8px 0 !important;
                margin: 0 !important;
                border-radius: 8px !important;
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.18) !important;
                list-style: none !important;
            }
            .header-navigation .main-menu ul.sub-menu > li {
                display: block !important;
                float: none !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
                list-style: none !important;
            }
            .header-navigation .main-menu ul.sub-menu > li > a {
                display: block !important;
                float: none !important;
                width: 100% !important;
                background-color: transparent !important;
                color: #1C231F !important;
                font-size: 14px !important;
                line-height: 1.4 !important;
                white-space: normal !important;
                padding: 12px 20px !important;
                border-bottom: 1px solid rgba(0, 0, 0, 0.06) !important;
            }
            .header-navigation .main-menu ul.sub-menu > li:last-child > a {
                border-bottom: none !important;
            }
            .header-navigation .main-menu ul.sub-menu > li > a:hover {
                background-color: #F2F1EE !important;
                color: #8FAB45 !important;
            }
        </style>
        {% endblock %}

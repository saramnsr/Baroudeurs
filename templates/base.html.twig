        <!--====== Header scroll color js ======-->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var header = document.querySelector('.header-navigation.transparent-header');
        if (header) {
            window.addEventListener('scroll', function () {
                if (window.scrollY > 50) {
                    header.classList.add('scrolled');
                    header.classList.add('sticky');
                } else {
                    header.classList.remove('scrolled');
                    header.classList.remove('sticky');
                }
            });
        }
    });
</script>

        <script>
(function () {
    var MOBILE_BREAKPOINT = 1199;
    function isMobile() { return window.innerWidth <= MOBILE_BREAKPOINT; }

    function closeAll() {
        document.querySelectorAll('.nav-menu .main-menu li.sub-menu-open')
            .forEach(function (li) { li.classList.remove('sub-menu-open'); });
    }

    document.addEventListener('click', function (e) {
        if (!isMobile()) return;

        var trigger = e.target.closest('.nav-menu .main-menu .dd-trigger');
        if (!trigger) return;

        e.preventDefault();
        e.stopPropagation();

        var li = trigger.closest('li.menu-item-has-children');
        if (!li) return;

        var wasOpen = li.classList.contains('sub-menu-open');
        closeAll();
        if (!wasOpen) li.classList.add('sub-menu-open');
    }, true);

    document.addEventListener('click', function (e) {
        if (!isMobile()) return;
        if (!e.target.closest('.navbar-toggler')) return;
        setTimeout(closeAll, 0);
        setTimeout(closeAll, 100);
        setTimeout(closeAll, 300);
    }, true);

    function initClose() { closeAll(); }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initClose);
    } else {
        initClose();
    }
    window.addEventListener('load', function () {
        closeAll();
        setTimeout(closeAll, 200);
        setTimeout(closeAll, 500);
    });

    var observer = new MutationObserver(function () {
        if (!isMobile()) return;
        document.querySelectorAll('.nav-menu .main-menu li.menu-item-has-children.active')
            .forEach(function (li) {
                if (!li.classList.contains('sub-menu-open')) {
                    li.classList.remove('active');
                }
            });
    });
    document.addEventListener('DOMContentLoaded', function () {
        var nav = document.querySelector('.nav-menu .main-menu');
        if (nav) {
            observer.observe(nav, { attributes: true, subtree: true, attributeFilter: ['class'] });
        }
    });
})();
</script>

<script>
(function () {
    function applyStickyColors() {
        var header = document.querySelector('.header-navigation');
        if (!header) return;

        var isSticky = header.classList.contains('scrolled') || header.classList.contains('sticky');
        if (!isSticky) return;

        var langCurrent = header.querySelector('.lang-current');
        if (langCurrent) {
            langCurrent.style.setProperty('color', '#1C231F', 'important');
            langCurrent.style.setProperty('-webkit-text-fill-color', '#1C231F', 'important');
            langCurrent.style.setProperty('background-color', 'rgba(0,0,0,.05)', 'important');
            langCurrent.style.setProperty('border-color', '#1C231F', 'important');
        }
        var langIcon = header.querySelector('.lang-current i');
        if (langIcon) {
            langIcon.style.setProperty('color', '#1C231F', 'important');
            langIcon.style.setProperty('-webkit-text-fill-color', '#1C231F', 'important');
        }

        var toggler = header.querySelector('.navbar-toggler');
        if (toggler) {
            toggler.style.setProperty('border-color', '#1C231F', 'important');
            toggler.style.setProperty('background-color', 'transparent', 'important');
            toggler.querySelectorAll('span').forEach(function (s) {
                s.style.setProperty('background', '#1C231F', 'important');
                s.style.setProperty('background-color', '#1C231F', 'important');
                s.style.setProperty('display', 'block', 'important');
                s.style.setProperty('visibility', 'visible', 'important');
                s.style.setProperty('opacity', '1', 'important');
            });
        }

        var navRight = header.querySelector('.nav-right-item');
        if (navRight) {
            navRight.style.setProperty('display', 'flex', 'important');
            navRight.style.setProperty('visibility', 'visible', 'important');
            navRight.style.setProperty('opacity', '1', 'important');
        }
        var langDrop = header.querySelector('.lang-dropdown');
        if (langDrop) {
            langDrop.style.setProperty('display', 'block', 'important');
            langDrop.style.setProperty('visibility', 'visible', 'important');
            langDrop.style.setProperty('opacity', '1', 'important');
        }
    }

    setInterval(applyStickyColors, 100);
    window.addEventListener('scroll', applyStickyColors, { passive: true });
    window.addEventListener('load', applyStickyColors);
    document.addEventListener('DOMContentLoaded', applyStickyColors);
})();
</script>

<script>
(function () {
    var MAX_WAIT_MS = 2000;

    function hidePreloader() {
        var pre = document.querySelector('.preloader');
        if (pre) {
            pre.style.transition = 'opacity .3s ease';
            pre.style.opacity = '0';
            pre.style.pointerEvents = 'none';
            setTimeout(function () {
                pre.style.display = 'none';
                pre.classList.add('loaded');
                document.body.style.overflow = '';
            }, 300);
        }
    }

    window.addEventListener('load', function () {
        setTimeout(hidePreloader, 200);
    });
    setTimeout(hidePreloader, MAX_WAIT_MS);
})();
</script>
